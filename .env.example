# Squirrels' Nest — environment variables
# Copy this file to `.env.local` for dev. Set the same vars in Vercel project
# settings for production. NEVER commit `.env.local` — it's gitignored.

# ──────────────────────────────────────────────────────────────────────────
# PUBLIC — inlined into the client bundle at build time (NEXT_PUBLIC_*)
# ──────────────────────────────────────────────────────────────────────────

# The canonical production URL. Used by metadataBase, sitemap, robots.
# Must be the REGISTERED domain (.com) — .co.uk was never registered.
NEXT_PUBLIC_SITE_URL=https://squirrelsneststay.com

# The Airbnb listing URL — every "Book on Airbnb" CTA points here. The live
# listing is already the in-code default, so you only need to set this to
# OVERRIDE it (e.g. a new listing). Use the clean room URL, no share params.
NEXT_PUBLIC_AIRBNB_URL=https://www.airbnb.co.uk/rooms/1703768527913896679

# Optional Instagram profile.
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/

# ──────────────────────────────────────────────────────────────────────────
# SERVER ONLY — never sent to the browser
# ──────────────────────────────────────────────────────────────────────────

# Resend API key — get one at https://resend.com (free tier: 3,000/mo).
# Without this, the contact form returns a graceful error and tells the
# user to email directly.
RESEND_API_KEY=

# Inbox that receives contact-form submissions. Defaults to BRAND.email
# (squirrelsneststay@gmail.com) if unset. This is the RECIPIENT and can be a
# Gmail address — it does not need to be on the domain.
CONTACT_TO_EMAIL=squirrelsneststay@gmail.com

# The verified-domain From address for Resend.
#  - DEV: leave this unset. The code falls back to `onboarding@resend.dev`,
#    Resend's sandbox sender, which delivers only to your own Resend account
#    email — fine for local testing.
#  - PROD: verify the squirrelsneststay.com domain in Resend, then set this
#    to a real address on that domain (below). The app FAILS CLOSED in
#    production if this is left as the sandbox sender, so you can't silently
#    lose real enquiries.
# CONTACT_FROM_EMAIL=noreply@squirrelsneststay.com
