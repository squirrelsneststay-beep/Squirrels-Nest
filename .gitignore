# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ──────────────────────────────────────────────────────────────────────────
# SECRETS — never commit, ever. If something here lands in git history,
# rotate the credential immediately and rewrite history (or rotate again).
# ──────────────────────────────────────────────────────────────────────────

# Environment variables. `.env.example` IS committed (template only, no
# secrets). Everything else with .env in the name is ignored, including
# .env, .env.local, .env.development.local, .env.production.local, etc.
.env
.env.*
!.env.example

# Private keys + certificate stores
*.pem
*.key
*.p12
*.pfx
*.cer
*.crt
*.der

# SSH + GPG keys (in case someone drops them in)
id_rsa
id_rsa.*
id_dsa
id_dsa.*
id_ecdsa
id_ecdsa.*
id_ed25519
id_ed25519.*
*.gpg
*.asc

# Cloud / service credentials
.aws/
.gcloud/
.azure/
.netrc
.npmrc
.yarnrc
.sentryclirc
service-account*.json
gcloud-service-key.json

# ──────────────────────────────────────────────────────────────────────────
# DEPENDENCIES + LOCK STATE
# ──────────────────────────────────────────────────────────────────────────

/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
.pnpm-store/

# ──────────────────────────────────────────────────────────────────────────
# BUILD / RUNTIME ARTIFACTS
# ──────────────────────────────────────────────────────────────────────────

/.next/
/out/
/build
/dist
.swc/
.turbo/
.cache/

# Vercel CLI local state — contains project linkage, sometimes tokens
.vercel/
.now/

# TypeScript build info
*.tsbuildinfo
next-env.d.ts

# ──────────────────────────────────────────────────────────────────────────
# TESTING + COVERAGE
# ──────────────────────────────────────────────────────────────────────────

/coverage
*.lcov
.nyc_output/

# ──────────────────────────────────────────────────────────────────────────
# LOGS + DEBUG
# ──────────────────────────────────────────────────────────────────────────

*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
lerna-debug.log*

# ──────────────────────────────────────────────────────────────────────────
# EDITOR / IDE — local-only settings that don't belong in a shared repo
# ──────────────────────────────────────────────────────────────────────────

# JetBrains (WebStorm, IntelliJ)
.idea/

# VS Code — ignore personal settings, allow shared workspace recommendations.
# If a team wants to commit `.vscode/settings.json` or `.vscode/launch.json`,
# move them to `.vscode/*.shared.json` or remove the negation rule.
.vscode/*
!.vscode/extensions.json

# Vim / Neovim
*.swp
*.swo
*~

# Sublime Text
*.sublime-workspace
*.sublime-project

# Zed
.zed/

# ──────────────────────────────────────────────────────────────────────────
# OS METADATA + JUNK
# ──────────────────────────────────────────────────────────────────────────

# macOS
.DS_Store
.AppleDouble
.LSOverride
.Spotlight-V100
.Trashes
.fseventsd
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# Linux
.directory

# ──────────────────────────────────────────────────────────────────────────
# TEMP + BACKUP FILES
# ──────────────────────────────────────────────────────────────────────────

*.bak
*.tmp
*.orig
*.rej
.vercel
